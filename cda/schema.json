{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDA_Model_v1",
  "type": "object",
  "required": [
    "version",
    "module",
    "updated",
    "title",
    "weights",
    "definitions"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "const": "CDA"
    },
    "updated": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "required": [
        "textual_fidelity",
        "scope_fidelity",
        "delegation_fidelity"
      ],
      "properties": {
        "textual_fidelity": {
          "type": "number"
        },
        "scope_fidelity": {
          "type": "number"
        },
        "delegation_fidelity": {
          "type": "number"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "good": {
          "type": "number"
        },
        "warning": {
          "type": "number"
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "term",
          "source_authority",
          "governing_definition",
          "applied_definition",
          "scope_domain",
          "textual_fidelity",
          "scope_fidelity",
          "delegation_fidelity"
        ],
        "properties": {
          "term": {
            "type": "string"
          },
          "source_authority": {
            "type": "string"
          },
          "governing_definition": {
            "type": "string"
          },
          "applied_definition": {
            "type": "string"
          },
          "scope_domain": {
            "type": "string"
          },
          "textual_fidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scope_fidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "delegation_fidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
