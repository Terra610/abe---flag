{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ABE CDA Output Schema",
  "type": "object",
  "required": [
    "module",
    "version",
    "timestamp",
    "input",
    "result",
    "plain_language"
  ],
  "properties": {
    "module": {
      "type": "string",
      "const": "cda"
    },
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "result": {
      "type": "object",
      "required": [
        "claimed_authority",
        "controlling_authority",
        "authority_conflict",
        "jurisdiction_status",
        "constitutional_violation",
        "void_ab_initio_flag",
        "ultra_vires_flag",
        "funding_scope_conflict",
        "off_mission_flag",
        "doctrine_triggers",
        "rights_impacted",
        "findings"
      ],
      "properties": {
        "claimed_authority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "controlling_authority": {
          "type": "array",
          "items": { "type": "string" }
        },
        "authority_conflict": {
          "type": "boolean"
        },
        "jurisdiction_status": {
          "type": "string"
        },
        "constitutional_violation": {
          "type": "boolean"
        },
        "void_ab_initio_flag": {
          "type": "boolean"
        },
        "ultra_vires_flag": {
          "type": "boolean"
        },
        "funding_scope_conflict": {
          "type": "boolean"
        },
        "off_mission_flag": {
          "type": "boolean"
        },
        "doctrine_triggers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rights_impacted": {
          "type": "array",
          "items": { "type": "string" }
        },
        "findings": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "plain_language": {
      "type": "object",
      "required": [
        "status",
        "explanation"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "what_authority_was_claimed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_authority_controls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_rights_are_impacted": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_doctrine_applies": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
