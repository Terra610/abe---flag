{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ABE_Integration_Artifact_v1",
  "type": "object",
  "required": [
    "module",
    "title",
    "version",
    "generated_at",
    "cli_execution_order",
    "phi_inputs",
    "signature_formula",
    "core_receipts"
  ],
  "additionalProperties": true,
  "properties": {
    "module": {
      "type": "string",
      "const": "ABE"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "cli_execution_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phi_inputs": {
      "type": "object",
      "required": ["CIRI", "CIBS", "CII", "CDI"],
      "additionalProperties": true
    },
    "signature_formula": {
      "type": "object",
      "required": ["expression", "numerator", "denominator", "value"],
      "additionalProperties": true
    },
    "core_receipts": {
      "type": "object",
      "required": ["CDI", "CIRI", "CIBS", "CII"],
      "additionalProperties": true
    }
  }
}
