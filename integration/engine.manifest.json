{
  "engine": "ABE",
  "layer": "integration",
  "version": "1.0.0",
  "local_only": true,

  "inputs": {
    "ciri": "../ciri/output.json",
    "cibs": "../cibs/output.json",
    "intake": "../intake/intake_artifact.json"
  },

  "models": {
    "model": "model.json",
    "schema": "schema.json"
  },

  "orchestrator": "orchestrator.js",

  "outputs": {
    "audit": "audit_attestation.json",
    "receipt_prefix": "abe_audit_"
  },

  "integrity": {
    "hash": "sha256",
    "timestamp": true,
    "deterministic": true
  }
}
