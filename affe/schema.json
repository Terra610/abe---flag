{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AFFE_Model_v1",
  "type": "object",
  "required": [
    "version",
    "module",
    "updated",
    "title",
    "weights"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "const": "AFFE"
    },
    "updated": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "required": [
        "recovery_durability",
        "system_stability",
        "forward_integrity"
      ],
      "properties": {
        "recovery_durability": {
          "type": "number"
        },
        "system_stability": {
          "type": "number"
        },
        "forward_integrity": {
          "type": "number"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "good": {
          "type": "number"
        },
        "warning": {
          "type": "number"
        }
      }
    },
    "defaults": {
      "type": "object"
    }
  }
}
