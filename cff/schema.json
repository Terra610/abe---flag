{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFF_Model_v1",
  "type": "object",
  "required": [
    "version",
    "module",
    "updated",
    "title",
    "weights",
    "funding_streams"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "const": "CFF"
    },
    "updated": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "weights": {
      "type": "object",
      "required": [
        "appropriation_fidelity",
        "use_fidelity",
        "traceability_fidelity"
      ],
      "properties": {
        "appropriation_fidelity": {
          "type": "number"
        },
        "use_fidelity": {
          "type": "number"
        },
        "traceability_fidelity": {
          "type": "number"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "good": {
          "type": "number"
        },
        "warning": {
          "type": "number"
        }
      }
    },
    "funding_streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stream_id",
          "program_name",
          "authorized_use_usd",
          "actual_use_usd",
          "appropriation_fidelity",
          "use_fidelity",
          "traceability_fidelity"
        ],
        "properties": {
          "stream_id": {
            "type": "string"
          },
          "program_name": {
            "type": "string"
          },
          "authorized_use_usd": {
            "type": "number",
            "minimum": 0
          },
          "actual_use_usd": {
            "type": "number",
            "minimum": 0
          },
          "appropriation_fidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "use_fidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "traceability_fidelity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
