{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAE_Model_v1",
  "type": "object",
  "required": [
    "version",
    "module",
    "updated",
    "title",
    "weights",
    "articles"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "const": "CAE"
    },
    "updated": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "weights": {
      "type": "object",
      "required": [
        "clarity_of_scope",
        "constitutional_nexus",
        "operational_fidelity"
      ],
      "properties": {
        "clarity_of_scope": {
          "type": "number"
        },
        "constitutional_nexus": {
          "type": "number"
        },
        "operational_fidelity": {
          "type": "number"
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "clauses"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "clauses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "clause_id",
                "reference",
                "title",
                "constitutional_anchor",
                "intent",
                "statutes",
                "regulations",
                "scope_notes",
                "tags",
                "evidence_links",
                "alignment_score",
                "confidence",
                "source_hash"
              ],
              "properties": {
                "clause_id": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "constitutional_anchor": {
                  "type": "string"
                },
                "intent": {
                  "type": "string"
                },
                "statutes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "regulations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "scope_notes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "tags": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_links": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "alignment_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
