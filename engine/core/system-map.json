{
  "engine_id": "ABE_FLAG",
  "engine_version": "1.0",
  "description": "ABE Flag - local-only constitutional alignment engine.",
  "firing_order": [
    "intake",
    "system",
    "cae",
    "divergence",
    "ccri",
    "cff",
    "affe",
    "ciri",
    "cibs",
    "cii",
    "macro"
  ],
  "modules": {
    "intake": {
      "required": true,
      "runner": "../intake/index.js",
      "produces": ["inputs.intake"]
    },
    "system": {
      "required": false,
      "runner": "../system/index.js",
      "produces": ["derived.systemmap"]
    },
    "cae": {
      "required": false,
      "runner": "../cae/index.js",
      "produces": ["derived.cae"]
    },
    "divergence": {
      "required": true,
      "impl": "cda",
      "runner": "../cda/index.js",
      "requires": ["inputs.intake"],
      "produces": ["derived.divergence"]
    },
    "ccri": {
      "required": false,
      "runner": "../ccri/index.js",
      "produces": ["derived.ccri"]
    },
    "cff": {
      "required": false,
      "runner": "../cff/index.js",
      "produces": ["derived.cff"]
    },
    "affe": {
      "required": false,
      "runner": "../affe/index.js",
      "requires": ["derived.cff"],
      "produces": ["derived.affe"]
    },
    "ciri": {
      "required": true,
      "runner": "../ciri/index.js",
      "requires": ["derived.divergence"],
      "produces": ["derived.ciri"]
    },
    "cibs": {
      "required": true,
      "runner": "../cibs/index.js",
      "requires": ["derived.ciri"],
      "produces": ["derived.cibs"]
    },
    "cii": {
      "required": true,
      "runner": "../cii/index.js",
      "requires": ["derived.cibs"],
      "produces": ["derived.cii"]
    },
    "macro": {
      "required": false,
      "runner": "../macro/index.js",
      "requires": ["derived.ciri"],
      "produces": ["derived.macro"]
    }
  }
}

